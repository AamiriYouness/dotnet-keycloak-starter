<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageReference Include="Testcontainers.Keycloak" Version="4.16.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Keycloak.Starter.Api\Keycloak.Starter.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Keycloak.Starter.Transactions/Keycloak.Starter.Transactions.csproj" Aliases="TransactionsApi" />
        <ProjectReference Include="../../src/Keycloak.Starter.Worker/Keycloak.Starter.Worker.csproj" Aliases="WorkerApp" />
        <None Include="../../keycloak/realm-export.json" Link="TestData/delegation-realm.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <None Update="TestData\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
