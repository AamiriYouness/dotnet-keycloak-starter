{
    admin off
    auto_https disable_redirects
    https_port {$HTTPS_PORT:443}
    http_port {$HTTP_PORT:80}
}

https://{$WEB_HOST}:{$HTTPS_PORT:443} {
    tls /run/secrets/tls-chain.pem /run/secrets/tls-key.pem
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy web:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}

https://{$AUTH_HOST}:{$HTTPS_PORT:443} {
    tls /run/secrets/tls-chain.pem /run/secrets/tls-key.pem
    header Strict-Transport-Security "max-age=31536000"
    @realm path /realms/starter/* /resources/*
    handle @realm {
        reverse_proxy keycloak:8080 {
            header_up -Forwarded
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$AUTH_HOST}
            header_up X-Forwarded-Port {$HTTPS_PORT:443}
        }
    }
    handle {
        respond 404
    }
}

http://{$WEB_HOST}:{$HTTP_PORT:80}, http://{$AUTH_HOST}:{$HTTP_PORT:80} {
    redir https://{host}:{$HTTPS_PORT:443}{uri} 308
}

http://:8080 {
    respond /health 200
}
