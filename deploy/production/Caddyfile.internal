{
    admin off
    auto_https disable_redirects
}

https://{$ACCOUNTS_HOST} {
    tls /run/secrets/tls-chain.pem /run/secrets/tls-key.pem
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy api:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}

https://{$TRANSACTIONS_HOST} {
    tls /run/secrets/tls-chain.pem /run/secrets/tls-key.pem
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy transactions:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}

http://:8080 {
    respond /health 200
}
