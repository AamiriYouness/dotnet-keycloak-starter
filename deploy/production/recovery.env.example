# Recovery example: preserve the original hostnames and canonical origins.
# Update these example domains to match the restored deployment; do not change public DNS.
WEB_HOST=app.example.com
AUTH_HOST=auth.example.com
ACCOUNTS_HOST=accounts.example.com
TRANSACTIONS_HOST=transactions.example.com
WEB_ORIGIN=https://app.example.com
KEYCLOAK_ORIGIN=https://auth.example.com
KEYCLOAK_ADMIN_USER=deployment-admin
# Absolute directory prepared using prepare-secrets.sh; never commit its contents.
DEPLOYMENT_SECRETS_DIR=/srv/keycloak-starter/recovery-secrets
APPLICATION_SUBNET=172.30.60.0/24
APPLICATION_DYNAMIC_RANGE=172.30.60.128/25
EDGE_PROXY_IP=172.30.60.2
INTERNAL_PROXY_IP=172.30.60.3
EDGE_BIND=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80

# Host publication may differ from the canonical listener ports during an isolated recovery drill.
HTTPS_PUBLISHED_PORT=18443
HTTP_PUBLISHED_PORT=18080
