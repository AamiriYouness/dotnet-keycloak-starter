{
  "realm": "starter",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Keycloak .NET Starter",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "client": {
      "starter-api": [
        {
          "name": "reader",
          "description": "Read the API's protected reader endpoint"
        },
        {
          "name": "admin",
          "description": "Access the API's administration endpoint"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "starter-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "starter-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-demo-reader-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "starter-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "starter-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "starter-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-demo-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "starter-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "starter-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "starter-no-role",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-demo-none-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "starter-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "starter-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "starter-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-demo-web-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile"
      ],
      "redirectUris": [
        "https://localhost:7002/signin-oidc"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7002/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "starter-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "starter-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "starter-api": [
      {
        "client": "starter-cli",
        "roles": [
          "reader"
        ]
      },
      {
        "client": "starter-admin",
        "roles": [
          "admin"
        ]
      },
      {
        "client": "starter-web",
        "roles": [
          "reader",
          "admin"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-starter-cli",
      "enabled": true,
      "serviceAccountClientId": "starter-cli",
      "clientRoles": {
        "starter-api": [
          "reader"
        ]
      }
    },
    {
      "username": "service-account-starter-admin",
      "enabled": true,
      "serviceAccountClientId": "starter-admin",
      "clientRoles": {
        "starter-api": [
          "admin"
        ]
      }
    },
    {
      "username": "service-account-starter-no-role",
      "enabled": true,
      "serviceAccountClientId": "starter-no-role"
    },
    {
      "username": "demo-reader",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "demo-reader",
      "email": "demo-reader@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-reader-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "starter-api": [
          "reader"
        ]
      }
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "demo-admin",
      "email": "demo-admin@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-admin-user-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "starter-api": [
          "admin"
        ]
      }
    },
    {
      "username": "demo-unprivileged",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "demo-unprivileged",
      "email": "demo-unprivileged@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-user-password",
          "temporary": false
        }
      ]
    }
  ]
}
